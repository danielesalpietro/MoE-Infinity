# Copy this file to .env and fill in what you need. docker compose reads
# .env automatically -- these values fill in the ${VAR:-default} references
# in docker-compose.webui.yml so you don't have to export them by hand
# every time you run start-webui.ps1 / start-webui.sh.

# --- HuggingFace ---
# Optional but recommended: raises HF Hub rate limits for model downloads
# and metadata lookups (model-status service), and is required for gated
# repos. Create one at https://huggingface.co/settings/tokens (read access
# is enough).
HF_TOKEN=

# --- Served model (moe-infinity service) ---
# Any HuggingFace MoE checkpoint registered in
# moe_infinity/common/constants.py -- see README "Supported Models".
# Default is a tiny randomly-initialized Mixtral checkpoint (a few MB,
# bfloat16) -- a fast T0 smoke test for the offload/serve pipeline. Must be
# bfloat16 (the fused MoE CUDA kernel rejects fp16/fp32 checkpoints with
# "BF16 only"). Swap in a real checkpoint (e.g.
# deepseek-ai/DeepSeek-V2-Lite-Chat) once that's verified.
MOE_MODEL=vprovorg/tiny-random-Mixtral-8x7B-v0.1

# Fraction of GPU memory reserved for expert caching. Lower this if you hit
# OOM (0.5 is a safe starting point for 16-24GB GPUs).
MOE_DEVICE_MEMORY_RATIO=0.5

# Fraction of remaining GPU memory reserved for paged KV cache blocks.
MOE_KV_CACHE_RATIO=0.15

# Maximum number of concurrent sequences in a batch.
MOE_MAX_BATCH_SIZE=8

# Comma-separated API keys to require on the OpenAI-compatible server.
# Leave empty to disable auth (fine for a local-only setup).
MOE_API_KEYS=

# Root Python logging level: debug, info, warning, error, critical. Leave
# empty for the server's own default -- only set this (e.g. to debug) while
# actively diagnosing a slow/stuck model load, not as a standing setting;
# it's noisy and DEBUG can leak more detail into logs than you want left on
# by default. Applied via docker/sitecustomize.py, because api_server_v2 has
# no --log-level flag (it hardcodes uvicorn's log_level="info").
MOE_LOG_LEVEL=

# Extra api_server_v2 flags with no dedicated MOE_* variable, passed through
# verbatim (word-split), e.g. "--enable-prefix-caching --enable-chunked-prefill".
MOE_EXTRA_ARGS=

# --- GPU selection -----------------------------------------------------
# Which GPUs the containers see: nvidia-smi indices, GPU-<uuid> strings, a
# comma-separated list, or "all". Prefer UUIDs -- indices can be reordered
# by the driver's enumeration mode.
#
# On a host with GPUs of more than one compute capability this is not a
# tuning knob. The fused MoE kernels are compiled for the single CUTLASS
# architecture below, so pointing this at a card of a different capability
# is a runtime kernel failure, not a slowdown. Change both together.
MOE_GPU_DEVICE_IDS=0
CUTLASS_VERSION=v3.9.2
CUTLASS_NVCC_ARCHS=86

# --- Storage -----------------------------------------------------------
# Host directory for the HF cache, the expert offload spill and Open WebUI's
# chat database. These grow to tens of GB with a real checkpoint -- point it
# at your fastest roomy filesystem.
MOE_DATA_ROOT=./.data

# --- Network -----------------------------------------------------------
# Interface the three ports (8000 API, 3000 chat, 8600 dashboard) bind to.
# Loopback by default: Open WebUI grants admin to its first visitor, so on
# any host reachable from outside, leave this alone and use an SSH tunnel.
MOE_BIND_ADDR=127.0.0.1

# How long the healthcheck waits before counting failures, while the model
# downloads and the offload index is built. Raise it for large checkpoints.
MOE_HEALTH_START_PERIOD=600s

# --- Dashboard (model-status service, http://localhost:8600) ---
# Total physical host RAM in GB, used only for the dashboard's "Host RAM"
# gauge. start-webui.ps1/.sh set this automatically each run (best effort);
# only set it here if that detection fails for your setup. Leave empty to
# just skip that one gauge -- everything else on the dashboard still works.
HOST_RAM_TOTAL_GB=

# "Shared GPU memory" (pinned system RAM mapped for the GPU, shown in
# Windows Task Manager's GPU tab) has no Linux/nvidia-smi equivalent, so it
# can't be read from inside the container -- start-webui.ps1/.sh set these
# automatically on Windows (best effort, via Get-Counter). The total is an
# estimate (half of HOST_RAM_TOTAL_GB, Windows' default policy), not an
# authoritative limit. Leave both empty to just skip that gauge.
HOST_GPU_SHARED_USED_GB=
HOST_GPU_SHARED_TOTAL_GB=

# --- Build options ---
# flash-attn is a pure speed optimization (automatic eager-attention
# fallback when absent) but is by far the slowest, most RAM/disk-hungry
# part of the build since it compiles from source. Leave false unless you
# need maximum throughput and can afford the extra build time.
INSTALL_FLASH_ATTN=false
