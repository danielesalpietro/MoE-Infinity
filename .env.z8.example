# Z8 G4 (berlin-3eie) profile -- copy to .env on that host:
#
#   cp .env.z8.example .env
#
# Everything here is host-specific. For a generic host start from
# .env.example instead; this file only documents why the Z8's values differ
# from the defaults.

# --- GPU ---------------------------------------------------------------
# The Z8 has two GPUs of *different* compute capability:
#   0  RTX 3090     sm_86   24 GB   GPU-43a04d95-0acb-c344-96a9-0efd013e32a4
#   1  RTX 5060 Ti  sm_120  16 GB   GPU-f8774b4a-bc76-d044-772a-5fbef5d2083c
#
# The fused MoE kernels are compiled for one CUTLASS architecture, so the
# image and the GPU have to agree. This profile targets the 3090: it is the
# arch the serving image has always been built for (CUTLASS 3.9.2 / sm_86),
# and its 24 GB comfortably holds a 7B checkpoint in bfloat16.
#
# Pinned by UUID, not index -- indices move when the driver's enumeration
# mode changes, UUIDs do not.
#
# To target the 5060 Ti instead you need the Blackwell toolchain, not just a
# different id here: CUTLASS_VERSION=v4.4.0, CUTLASS_NVCC_ARCHS=120 and the
# nvcr.io PyTorch base (see docker/Dockerfile.blackwell), which is a
# separate, less-exercised build. Change both together or not at all.
MOE_GPU_DEVICE_IDS=GPU-43a04d95-0acb-c344-96a9-0efd013e32a4
CUTLASS_VERSION=v3.9.2
CUTLASS_NVCC_ARCHS=86

# --- Storage -----------------------------------------------------------
# /mnt/pmem_emh2 is the 248 GB persistent-memory filesystem (~218 GB free).
# The offload directory is exactly the workload PMEM is interesting for, so
# the HF cache, the offload spill and the chat database all live there
# rather than on the SATA-backed Docker root.
MOE_DATA_ROOT=/mnt/pmem_emh2/moe-infinity

# --- Network -----------------------------------------------------------
# The Z8 is a headless server: the UI has to be reachable from a browser on
# another machine on the LAN, so the ports bind to its LAN address on eno1
# rather than to loopback.
#
# Bound to the specific address, not 0.0.0.0, so the services do not also
# appear on the docker0 / br-* bridges shared with the other stacks on this
# host. Note what this does and does not buy: eno1 is also the interface
# the router's NAT arrives on, so the only thing keeping these ports off
# the internet is that the router forwards 2222 and nothing else. If port
# forwarding is ever widened, revisit this line first.
#
# If this host's DHCP lease ever moves it off .110, update this value --
# docker refuses to start a container whose published address does not
# exist on the host.
MOE_BIND_ADDR=192.168.1.110

# Ports. NOT the 3000/8000/8600 defaults: on this host those are already
# claimed by northstream-open-webui, northstream-landing and
# caliper-verifier respectively. Those containers are stopped right now, so
# the collision would not show up today -- it would show up as a failure to
# start the *other* stacks, later, with no obvious connection to this one.
# The 8700 block is unused on this host by anything, container or native.
MOE_API_PORT=8700
MOE_WEBUI_PORT=8701
MOE_STATUS_PORT=8702

# From a PC on 192.168.1.0/24:
#   http://192.168.1.110:8701   chat
#   http://192.168.1.110:8702   dashboard
#   http://192.168.1.110:8700/health
#
# Open WebUI grants admin to whoever registers first. On a LAN-exposed
# instance that means: create your account immediately after the first
# start, before anyone else on the network reaches it.

# --- Model -------------------------------------------------------------
# Start on the tiny random Mixtral to prove the pipeline, then switch to
# allenai/OLMoE-1B-7B-0924-Instruct, which is the checkpoint that reproduces
# the crash tracked in EfficientMoE/MoE-Infinity#123.
MOE_MODEL=vprovorg/tiny-random-Mixtral-8x7B-v0.1

# 24 GB card, one model, no other tenants -- room to be generous. Lower
# MOE_DEVICE_MEMORY_RATIO first if you hit OOM.
MOE_DEVICE_MEMORY_RATIO=0.5
MOE_KV_CACHE_RATIO=0.15
MOE_MAX_BATCH_SIZE=8

# 235 GB of host RAM; feeds the dashboard's Host RAM gauge only.
HOST_RAM_TOTAL_GB=235

# --- Build -------------------------------------------------------------
# flash-attn compiles from source with no prebuilt wheel for this
# torch/CUDA/Python combination and is by far the longest, most RAM-hungry
# build step. It is a pure speed optimization with an automatic
# eager-attention fallback, and we are chasing a correctness bug, not
# throughput. Leave it off.
INSTALL_FLASH_ATTN=false

# Empty = no auth on the API. Fine while bound to loopback.
MOE_API_KEYS=
HF_TOKEN=
MOE_LOG_LEVEL=
